# Copy the values you need into a local .env.local file (git-ignored)
# or into your deployment provider's secret manager. Keep database
# credentials server-side; never use a NEXT_PUBLIC_ prefix.

# Postgres connection string (Supabase).
# Use the Supabase "Session Pooler" URL for IPv4-only / serverless runtimes.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full

# Newsroom admin sign-in.
# AUTH_SECRET: long random string (>= 16 chars) used to sign session cookies.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
# ADMIN_PASSWORD: the password editors type on /login.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: allow triggering /api/seed with header "x-seed-token: <value>" (CI only).
# Leave unset in production; the newsroom session also authorizes seeding.
SEED_TOKEN=
